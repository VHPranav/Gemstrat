// Cloudflare Workers: serves the static export in out/ (`npm run deploy`).
// No Worker code; static assets only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gemstrat",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./out",
    // Unknown paths get out/404.html with a 404 status
    "not_found_handling": "404-page"
  }
}
