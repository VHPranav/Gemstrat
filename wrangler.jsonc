// Cloudflare Workers: serves the static export in out/ (`npm run deploy`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gemstrat",
  "compatibility_date": "2026-10-13",
  // Only handles byte-range requests for the videos (Safari needs them);
  // see worker/index.ts
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // Unknown paths get out/404.html with a 404 status
    "not_found_handling": "404-page",
    // Everything else is served straight from the assets
    "run_worker_first": ["/videos/*"]
  }
}
